{
  "name": "realtime-examples",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "server:dev": "tsx watch --tsconfig server/tsconfig.json server/server.ts",
    "twilio:set-webhook": "node -e \"const t=require('twilio');const c=t(process.env.TWILIO_ACCOUNT_SID,process.env.TWILIO_AUTH_TOKEN);c.incomingPhoneNumbers.list({phoneNumber:process.env.TWILIO_PHONE_NUMBER}).then(ns=>c.incomingPhoneNumbers(ns[0].sid).update({voiceUrl:'https://'+process.env.PUBLIC_DOMAIN+'/twilio/incoming-call',voiceMethod:'POST'})).then(n=>console.log('Webhook set:',n.voiceUrl)).catch(e=>console.error(e.message))\"",
    "dev:all": "concurrently \"npm run dev\" \"npm run server:dev\"",
    "server:start": "tsx --tsconfig server/tsconfig.json server/server.ts",
    "start:all": "concurrently \"npm run start\" \"npm run server:start\""
  },
  "dependencies": {
